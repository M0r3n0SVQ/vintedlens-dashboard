# Copia este archivo a .env.local (ignorado por git) y rellena los
# valores reales: output "api_endpoint" y "terraform output -raw
# api_key" del repo VintedLens (backend). Sin prefijo NEXT_PUBLIC_ a
# propósito: estas variables solo deben existir en el servidor,
# nunca en el bundle del navegador.

VINTEDLENS_API_ENDPOINT=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/
VINTEDLENS_API_KEY=tu-api-key
